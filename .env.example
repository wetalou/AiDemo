# 复制本文件为 .env 后填写真实值：
#   cp .env.example .env
#
# 优先级说明（app/common/env_utils.py）：
#   1) 通用 OpenAI 兼容 / 阿里百炼：DATA_* 优先于 ALI_BAILIAN_*
#   2) DashScope 直连（通义官方兼容端点）：DASHSCOPE_API_KEY
#      （可选 DASHSCOPE_BASE_URL，缺省为官方 compatible-mode）

# ---- 阿里百炼（推荐先填这三项）----
ALI_BAILIAN_API_KEY=your_api_key_here
ALI_BAILIAN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
ALI_BAILIAN_MODEL=deepseek-v4-flash-0731

# ---- 可选别名（设置后优先生效）----
# DATA_API_KEY=
# DATA_BASE_URL=
# DATA_MODEL=

# ---- DashScope（app/models/03_qwen_chat、app/agents/04_qwen_agent）----
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
